---
// One app screenshot with a caption. `name` = a file in src/assets/screens (without .png).
import { Image } from 'astro:assets';

interface Props {
	name: string;
	alt: string;
	caption?: string;
}
const { name, alt, caption } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const shot = shots[`../assets/screens/${name}.png`];
if (!shot) throw new Error(`no screenshot src/assets/screens/${name}.png`);
---

<figure class="not-content">
	<Image src={shot.default} alt={alt} widths={[800, 1600]} sizes="(min-width: 50rem) 48rem, 100vw" class="screen" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figure {
		margin-block: 1.5rem;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
